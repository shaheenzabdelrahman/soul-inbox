# --- Server
NODE_ENV=production
PORT=3000
# Public HTTPS address of this server (Meta must reach /webhooks/meta and /media/*)
PUBLIC_URL=https://inbox.soulhospitality.com
DATA_DIR=./data
# 32+ random characters. Also encrypts channel access tokens - never change it after channels are connected.
SESSION_SECRET=
TIMEZONE=Africa/Cairo

# --- First admin (created only when the database is empty)
ADMIN_EMAIL=admin@soulhospitality.com
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# --- Meta app (developers.facebook.com > your app)
META_APP_ID=
META_APP_SECRET=
# Any random string; paste the same value in the app's Webhooks settings
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v23.0

# --- AI (optional). Without a key the inbox works fully, minus the AI buttons.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Test simulator (fake customers). Keep false in production after training.
SIMULATOR_ENABLED=false
